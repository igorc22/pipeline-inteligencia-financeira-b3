# Copie para .env e preencha. O .env não vai para o git.
# Onde conseguir cada chave: tabela "Chaves de API" no começo do README.

# --- LLM -------------------------------------------------------------------------------------------

# Obrigatória: chave do Gemini (aistudio.google.com/apikey). GOOGLE_API_KEY também é aceito.
# A busca na web pelo Google Search só funciona com faturamento ativo no projeto da chave.
GEMINI_API_KEY=

# Opcional: modelo do Gemini usado por todos os agentes (padrão: gemini-3.5-flash-lite)
# LLM_MODEL=gemini-3.5-flash-lite

# --- Dados de mercado ------------------------------------------------------------------------------

# Recomendada: token da Brapi (brapi.dev/dashboard, plano gratuito). Confere se o ticker existe antes
# de gastar uma análise e traz cotação, perfil, setor da B3 e os maiores do setor. Sem ele, tudo vem
# do yfinance e o relatório avisa. O yfinance e o Banco Central não precisam de chave.
BRAPI_API_KEY=

# --- Busca na web e notícias -----------------------------------------------------------------------

# Opcional: provedor da busca na web, google (padrão: Gemini com Google Search) ou tavily.
# Com tavily e sem TAVILY_API_KEY (ou com um valor inválido), a busca avisa no log e usa o google.
# BUSCA_PROVEDOR=google

# Opcional: chave da Tavily (app.tavily.com, em API Keys, começa com tvly-), usada só com
# BUSCA_PROVEDOR=tavily. O plano gratuito dá 1.000 créditos por mês, e cada busca gasta 1.
TAVILY_API_KEY=

# Obrigatória para buscar_noticias, a reserva da busca na web (newsapi.org/register, plano Developer)
NEWS_API_KEY=

# --- Segurança das entradas ------------------------------------------------------------------------

# Opcional: sanitização por IA do texto que volta das buscas (padrão: desligada).
# Ligada, cada busca na web ou na NewsAPI faz uma chamada extra ao Gemini para checar se o texto
# tenta dar ordens ao sistema. As tags XML e a validação do ticker funcionam com ela desligada.
# SANITIZACAO_ATIVA=false
# Opcional: modelo do classificador (padrão: o mesmo de LLM_MODEL)
# SANITIZACAO_MODELO=gemini-3.5-flash-lite

# --- Observabilidade -------------------------------------------------------------------------------

# Opcional
LOG_LEVEL=INFO

# Opcional: tracing no LangSmith (smith.langchain.com → Settings → API Keys)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Workspace do LangSmith Cloud é por agente: use AGENT_ID + AGENT_ENVIRONMENT, NUNCA junto com LANGSMITH_PROJECT
# (com os dois, o SDK não envia nada). Ambiente: local, development, staging ou production.
# LANGSMITH_AGENT_ID=pipeline-b3
# LANGSMITH_AGENT_ENVIRONMENT=local

# --- Evals (grupo dev) -----------------------------------------------------------------------------

# Desliga a telemetria que a deepeval manda por padrão ao ser importada
DEEPEVAL_TELEMETRY_OPT_OUT=1
# Opcional: modelo do juiz dos evals (padrão: gemini-3.8-flash, escolhido pelo custo)
# EVAL_MODELO=gemini-3.8-flash
