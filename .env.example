# Copie para .env e preencha. O .env não vai para o git.

# Obrigatória: chave do Gemini (Google AI Studio). GOOGLE_API_KEY também é aceito.
GEMINI_API_KEY=

# Opcional: modelo do Gemini usado por todos os agentes (padrão: gemini-3.5-flash-lite)
# LLM_MODEL=gemini-3.5-flash-lite

# Obrigatória para buscar_noticias (newsapi.org)
NEWS_API_KEY=

# Opcional
LOG_LEVEL=INFO

# Opcional: tracing no LangSmith (smith.langchain.com → Settings → API Keys)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Workspace do LangSmith Cloud é por agente: use AGENT_ID + AGENT_ENVIRONMENT, NUNCA junto com LANGSMITH_PROJECT
# (com os dois, o SDK não envia nada). Ambiente: local, development, staging ou production.
# LANGSMITH_AGENT_ID=pipeline-b3
# LANGSMITH_AGENT_ENVIRONMENT=local

# Reservada para a Fase 2 (PostgreSQL)
# DATABASE_URL=postgresql://...
